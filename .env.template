# ─────────────────────────────────────────────
#  BookUrTrim – variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────


# ── Base de données ───────────────────────────
# Format : postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookurtrim


# ── Authentification JWT ──────────────────────
# Clé secrète pour signer les tokens JWT (min. 32 caractères)
JWT_SECRET_KEY=change-me-use-a-long-random-string
# Durée de vie du token d'accès en minutes
JWT_ACCESS_TOKEN_TTL_MINUTES=60


# ── Paiement Stripe ───────────────────────────
# Clé secrète Stripe (sk_live_... ou sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Secret de vérification des webhooks Stripe
STRIPE_WEBHOOK_SECRET=whsec_...


# ── Documentation Swagger ─────────────────────
# 1 = activé (recommandé en development uniquement)
SWAGGER_ENABLED=0


# ── Application ───────────────────────────────
# Environnement : development | production | test
APP_ENV=development
# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
